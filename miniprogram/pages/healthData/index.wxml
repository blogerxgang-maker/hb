<!--pages/healthData/index.wxml-->
<view class="container">
  <!-- 未连接提示 -->
  <view wx:if="{{!isConnected}}" class="card not-connected">
    <text class="not-connected-icon">🔗</text>
    <text class="not-connected-text">未连接设备</text>
    <text class="not-connected-hint">请先在"连接"页面连接设备</text>
  </view>

  <block wx:else>
    <!-- 顶部同步卡 -->
    <view class="card sync-card">
      <view class="sync-info">
        <text class="sync-title">数据同步</text>
        <text class="sync-status">{{syncStatusText}}</text>
      </view>
      <button 
        class="sync-btn {{isSyncing ? 'syncing' : ''}} {{!isConnected ? 'disabled' : ''}}"
        bindtap="syncData"
        disabled="{{!isConnected || isSyncing}}"
      >
        <view wx:if="{{isSyncing}}" class="loading-spinner"></view>
        {{isSyncing ? '同步中…' : '同步数据'}}
      </button>
    </view>

    <!-- 运动卡 -->
    <view class="card sport-card">
      <text class="card-title">今日运动</text>
      <view class="sport-main">
        <text class="sport-value">{{sportData.step || 0}}</text>
        <text class="sport-unit">步</text>
      </view>
      <view class="sport-sub">
        <view class="sport-sub-item">
          <text class="sport-sub-value">{{sportData.calorie || 0}}</text>
          <text class="sport-sub-label">卡路里(kcal)</text>
        </view>
        <view class="sport-sub-item">
          <text class="sport-sub-value">{{sportData.distance || 0}}</text>
          <text class="sport-sub-label">距离(m)</text>
        </view>
      </view>
    </view>

    <!-- 睡眠卡 -->
    <view class="card sleep-card">
      <text class="card-title">睡眠数据</text>
      <view class="sleep-main">
        <text class="sleep-value">{{sleepData.totalTime || '--'}}</text>
      </view>
      <view class="sleep-sub">
        <view class="sleep-sub-item">
          <text class="sleep-sub-value">{{sleepData.deepTime || '--'}}</text>
          <text class="sleep-sub-label">深睡</text>
        </view>
        <view class="sleep-sub-item">
          <text class="sleep-sub-value">{{sleepData.lightTime || '--'}}</text>
          <text class="sleep-sub-label">浅睡</text>
        </view>
      </view>
    </view>

    <!-- 生理数据网格卡 -->
    <view class="card physio-card">
      <text class="card-title">生理数据</text>
      <view class="physio-grid">
        <view class="physio-item">
          <text class="physio-icon">❤️</text>
          <text class="physio-label">心率</text>
          <view>
            <text class="physio-value">{{physioData.heartRate || '--'}}</text>
            <text class="physio-unit">bpm</text>
          </view>
        </view>
        <view class="physio-item">
          <text class="physio-icon">💨</text>
          <text class="physio-label">血氧</text>
          <view>
            <text class="physio-value">{{physioData.bloodOxygen || '--'}}</text>
            <text class="physio-unit">%</text>
          </view>
        </view>
        <view class="physio-item">
          <text class="physio-icon">🩸</text>
          <text class="physio-label">血压</text>
          <view>
            <text class="physio-value">{{physioData.bloodPressure || '--'}}</text>
          </view>
        </view>
        <view class="physio-item">
          <text class="physio-icon">🍬</text>
          <text class="physio-label">血糖</text>
          <view>
            <text class="physio-value">{{physioData.bloodGlucose || '--'}}</text>
            <text class="physio-unit">mmol/L</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部同步状态 -->
    <view class="sync-footer">
      <text class="sync-footer-text">{{syncFooterText}}</text>
    </view>
  </block>
</view>
