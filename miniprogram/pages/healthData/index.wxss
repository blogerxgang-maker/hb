/* 健康数据页样式 - 健康友好配色 */

page {
  background-color: #FAFAFA;
  min-height: 100vh;
}

.container {
  padding: 24rpx;
  padding-bottom: 40rpx;
}

/* 通用卡片样式 - 阴影代替描边 */
.card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* 同步卡片 */
.sync-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sync-info {
  flex: 1;
}

.sync-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #37474F;
}

.sync-status {
  font-size: 24rpx;
  color: #78909C;
  margin-top: 8rpx;
}

.sync-btn {
  min-width: 160rpx;
  height: 72rpx;
  background-color: #4DB6AC;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.sync-btn::after {
  border: none;
}

.sync-btn.disabled {
  background-color: #B0BEC5;
}

.sync-btn.syncing {
  background-color: #78909C;
}

/* 运动卡片 */
.sport-card {
  text-align: center;
}

.sport-card .card-title {
  text-align: left;
  font-size: 28rpx;
  color: #78909C;
  margin-bottom: 24rpx;
}

.sport-main {
  margin-bottom: 32rpx;
}

.sport-value {
  font-size: 80rpx;
  font-weight: bold;
  color: #26A69A;
  line-height: 1;
}

.sport-unit {
  font-size: 28rpx;
  color: #78909C;
  margin-left: 8rpx;
}

.sport-sub {
  display: flex;
  justify-content: space-around;
}

.sport-sub-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sport-sub-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #37474F;
}

.sport-sub-label {
  font-size: 24rpx;
  color: #78909C;
  margin-top: 8rpx;
}

/* 睡眠卡片 */
.sleep-card .card-title {
  font-size: 28rpx;
  color: #78909C;
  margin-bottom: 24rpx;
}

.sleep-main {
  text-align: center;
  margin-bottom: 32rpx;
}

.sleep-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #26A69A;
}

.sleep-sub {
  display: flex;
  justify-content: space-around;
}

.sleep-sub-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sleep-sub-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #37474F;
}

.sleep-sub-label {
  font-size: 24rpx;
  color: #78909C;
  margin-top: 8rpx;
}

/* 生理数据网格卡片 */
.physio-card .card-title {
  font-size: 28rpx;
  color: #78909C;
  margin-bottom: 24rpx;
}

.physio-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.physio-item {
  background-color: #E0F2F1;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.physio-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.physio-label {
  font-size: 24rpx;
  color: #78909C;
  margin-bottom: 8rpx;
}

.physio-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #26A69A;
}

.physio-unit {
  font-size: 20rpx;
  color: #78909C;
  margin-left: 4rpx;
}

/* 底部状态文本 */
.sync-footer {
  text-align: center;
  padding: 24rpx;
}

.sync-footer-text {
  font-size: 24rpx;
  color: #78909C;
}

/* 未连接提示 */
.not-connected {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.not-connected-icon {
  font-size: 100rpx;
  color: #B0BEC5;
  margin-bottom: 32rpx;
}

.not-connected-text {
  font-size: 32rpx;
  color: #78909C;
  margin-bottom: 16rpx;
}

.not-connected-hint {
  font-size: 26rpx;
  color: #B0BEC5;
}

/* 加载状态 */
.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #B2DFDB;
  border-top: 4rpx solid #ffffff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-right: 12rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
