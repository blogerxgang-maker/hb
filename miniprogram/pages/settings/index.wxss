/* 设置页样式 - 健康友好配色 */

page {
  background-color: #FAFAFA;
  min-height: 100vh;
}

.container {
  padding: 24rpx;
  padding-bottom: 40rpx;
}

/* 通用卡片样式 - 阴影代替描边 */
.card {
  background-color: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.card-padding {
  padding: 32rpx;
}

/* 开关项 */
.switch-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #ECEFF1;
}

.switch-item:last-child {
  border-bottom: none;
}

.switch-item.disabled {
  opacity: 0.5;
}

.switch-info {
  flex: 1;
  margin-right: 24rpx;
}

.switch-title {
  font-size: 30rpx;
  color: #37474F;
  margin-bottom: 8rpx;
}

.switch-status {
  font-size: 24rpx;
  color: #78909C;
}

.switch-status.on {
  color: #26A69A;
}

.switch-status.off {
  color: #B0BEC5;
}

.switch-status.unsupported {
  color: #C62828;
}

/* 入口项 */
.entry-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #ECEFF1;
}

.entry-item:last-child {
  border-bottom: none;
}

.entry-item:active {
  background-color: #FAFAFA;
}

.entry-item.disabled {
  opacity: 0.5;
}

.entry-item.disabled:active {
  background-color: #ffffff;
}

.entry-title {
  font-size: 30rpx;
  color: #37474F;
}

.entry-arrow {
  font-size: 24rpx;
  color: #78909C;
}

.entry-value {
  font-size: 26rpx;
  color: #78909C;
  margin-right: 12rpx;
}

/* 连接状态卡片 */
.status-card {
  padding: 32rpx;
  display: flex;
  align-items: center;
}

.status-indicator {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.status-indicator.connected {
  background-color: #26A69A;
}

.status-indicator.disconnected {
  background-color: #B0BEC5;
}

.status-text {
  font-size: 30rpx;
  color: #37474F;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  padding: 32rpx;
  border-bottom: 1rpx solid #ECEFF1;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #37474F;
  text-align: center;
}

.modal-body {
  padding: 24rpx;
  max-height: 600rpx;
  overflow-y: auto;
}

.modal-option {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 16rpx;
  border-radius: 12rpx;
}

.modal-option:active {
  background-color: #FAFAFA;
}

.modal-option.selected {
  background-color: #E0F2F1;
}

.modal-option-text {
  font-size: 30rpx;
  color: #37474F;
}

.modal-option-check {
  color: #4DB6AC;
  font-size: 32rpx;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #ECEFF1;
}

.modal-btn {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  background-color: transparent;
  border: none;
  border-radius: 0;
}

.modal-btn::after {
  border: none;
}

.modal-btn-cancel {
  color: #78909C;
  border-right: 1rpx solid #ECEFF1;
}

.modal-btn-confirm {
  color: #4DB6AC;
  font-weight: 500;
}

.modal-btn-danger {
  color: #C62828;
  font-weight: 500;
}

/* 分组标题 */
.section-title {
  font-size: 26rpx;
  color: #78909C;
  padding: 24rpx 32rpx 16rpx;
}

/* 未连接提示 */
.not-connected {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.not-connected-icon {
  font-size: 100rpx;
  color: #B0BEC5;
  margin-bottom: 32rpx;
}

.not-connected-text {
  font-size: 32rpx;
  color: #78909C;
  margin-bottom: 16rpx;
}

.not-connected-hint {
  font-size: 26rpx;
  color: #B0BEC5;
}
