/* 自觉提醒页样式 - 健康友好配色 */

page {
  background-color: #fafafa;
  min-height: 100vh;
}

.container {
  padding: 24rpx;
  padding-bottom: 40rpx;
}

/* 通用卡片样式 - 阴影代替描边 */
.card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* 主开关卡片 */
.switch-card {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.switch-info {
  flex: 1;
  margin-right: 24rpx;
}

.switch-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #37474f;
  margin-bottom: 12rpx;
}

.switch-desc {
  font-size: 26rpx;
  color: #78909c;
  line-height: 1.5;
}

.switch-desc.active {
  color: #26a69a;
}

/* 时间卡片 */
.time-card .card-title {
  font-size: 28rpx;
  color: #78909c;
  margin-bottom: 24rpx;
}

.time-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eceff1;
}

.time-row:last-child {
  border-bottom: none;
}

.time-label {
  font-size: 30rpx;
  color: #37474f;
}

.time-picker {
  display: flex;
  align-items: center;
}

.time-value {
  font-size: 32rpx;
  font-weight: 500;
  color: #4db6ac;
  margin-right: 12rpx;
}

.time-arrow {
  font-size: 24rpx;
  color: #78909c;
}

.time-error {
  color: #c62828;
  font-size: 24rpx;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
}

.time-error-icon {
  margin-right: 8rpx;
}

/* 震动模式卡片 */
.mode-card .card-title {
  font-size: 28rpx;
  color: #78909c;
  margin-bottom: 24rpx;
}

.mode-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.mode-btn {
  flex: 1 0 calc(50% - 8rpx);
  min-width: calc(50% - 8rpx);
  max-width: calc(50% - 8rpx);
  height: 88rpx;
  background-color: #e0f2f1;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #37474f;
  position: relative;
  padding: 0 16rpx;
  box-sizing: border-box;
}

.mode-btn.selected {
  background-color: #4db6ac;
  color: #ffffff;
}

.mode-btn .mode-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: transparent;
  border: 2rpx solid #78909c;
  margin-right: 12rpx;
}

.mode-btn.selected .mode-dot {
  background-color: #ffffff;
  border-color: #ffffff;
}

.mode-desc {
  font-size: 24rpx;
  color: #78909c;
  line-height: 1.6;
  padding: 16rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
}

/* 间隔卡片 */
.interval-card .card-title {
  font-size: 28rpx;
  color: #78909c;
  margin-bottom: 16rpx;
}

.interval-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.interval-input-wrap {
  display: flex;
  align-items: baseline;
}

.interval-input {
  width: 120rpx;
  font-size: 48rpx;
  font-weight: bold;
  color: #26a69a;
  text-align: center;
  border-bottom: 4rpx solid #b2dfdb;
  padding-bottom: 4rpx;
  line-height: 1.2;
}

.interval-unit {
  font-size: 28rpx;
  color: #78909c;
  margin-left: 8rpx;
}

.interval-range {
  font-size: 24rpx;
  color: #b0bec5;
}

.interval-slider {
  width: 100%;
}

.slider-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
}

.slider-label {
  font-size: 22rpx;
  color: #78909c;
}

/* 保存条 */
.save-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.save-status {
  flex: 1;
}

.save-status-text {
  font-size: 26rpx;
  color: #78909c;
}

.save-status-text.connected {
  color: #26a69a;
}

.save-status-text.disconnected {
  color: #c62828;
}

.save-btn {
  min-width: 160rpx;
  height: 80rpx;
  background-color: #4db6ac;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.save-btn::after {
  border: none;
}

.save-btn.disabled {
  background-color: #b0bec5;
}

.save-btn.saving {
  background-color: #78909c;
}

/* 未连接提示 */
.not-connected {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.not-connected-icon {
  font-size: 100rpx;
  color: #b0bec5;
  margin-bottom: 32rpx;
}

.not-connected-text {
  font-size: 32rpx;
  color: #78909c;
  margin-bottom: 16rpx;
}

.not-connected-hint {
  font-size: 26rpx;
  color: #b0bec5;
}

/* 加载动画 */
.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #b2dfdb;
  border-top: 4rpx solid #ffffff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-right: 12rpx;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

/* 关闭提醒按钮 */
.close-bar {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
}

.close-btn {
  width: 100%;
  height: 88rpx;
  background-color: #ffffff;
  color: #c62828;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #e57373;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.close-btn::after {
  border: none;
}

.close-btn.disabled {
  background-color: #eceff1;
  color: #b0bec5;
  border-color: #cfd8dc;
}
