.container {
  padding: 30rpx;
  background-color: #f7f9fb;
  min-height: 100vh;
}

.reminder-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.reminder-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.title-group {
  display: flex;
  align-items: center;
}

.icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2F3133;
}

.card-body {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 30rpx;
  border-top: 1rpx solid #f0f3f5;
}

.card-body.disabled {
  opacity: 0.3;
}

.label {
  font-size: 30rpx;
  color: #5F6368;
}

.picker-value {
  font-size: 30rpx;
  color: #4DB6AC;
  font-weight: 500;
  display: flex;
  align-items: center;
}

.arrow {
  font-size: 24rpx;
  margin-left: 10rpx;
  color: #bdc1c6;
}

.footer-tip {
  margin-top: 60rpx;
  text-align: center;
  font-size: 26rpx;
  color: #bdc1c6;
  font-style: italic;
}
